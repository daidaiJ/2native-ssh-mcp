{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.daidaiJ/2native-ssh-mcp",
  "title": "2native SSH MCP Server",
  "description": "SSH-based MCP server for remote command execution and file transfer with named sessions, progress notifications, and resumable transfers. SSH credentials stay local and are never exposed to the model.",
  "version": "1.0.0",
  "repository": {
    "url": "https://github.com/daidaiJ/2native-ssh-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/daidaiJ/2native-ssh-mcp/releases/download/v1.0.0/2native-ssh-mcp-linux-amd64.mcpb",
      "fileSha256": "<sha256-of-the-mcpb-file>",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}