FROM debian:12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssh-server \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/sshd /root/.ssh
# Authorized keys are injected at container start through a per-run volume
# mount generated by proxyjump_integration_test.go; host keys are created by
# ssh-keygen -A inside the container. Nothing secret lives in this image.
CMD ["/bin/sh", "-c", "ssh-keygen -A && exec /usr/sbin/sshd -D -e -o PermitRootLogin=yes -o PasswordAuthentication=no"]
